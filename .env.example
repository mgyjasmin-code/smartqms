# Copy values into the deployment secret manager; do not commit a populated .env.
SMARTQMS_APP_ENV=production
SMARTQMS_APP_DEBUG=0
SMARTQMS_APP_URL=https://queue.example.gov.ph
SMARTQMS_TRUST_PROXY=0
SMARTQMS_TRUSTED_PROXY_IPS=

SMARTQMS_DB_HOST=127.0.0.1
SMARTQMS_DB_PORT=3306
SMARTQMS_DB_NAME=smartqms
SMARTQMS_DB_USER=smartqms_runtime
SMARTQMS_DB_PASS=
SMARTQMS_DATA_PROVIDER=local

EMAIL_DELIVERY_MODE=smtp
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=tls
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=SmartQMS

SMARTQMS_BOOTSTRAP_ADMIN_EMAIL=
SMARTQMS_BOOTSTRAP_ADMIN_PASSWORD=
SMARTQMS_BOOTSTRAP_ADMIN_FIRST_NAME=
SMARTQMS_BOOTSTRAP_ADMIN_LAST_NAME=

SMARTQMS_SMS_ENABLED=0
SMARTQMS_SMS_PROVIDER=fmcsms
SMARTQMS_SMS_API_KEY=
SMARTQMS_SMS_SENDER_NAME=SmartQMS
SMARTQMS_SMS_FROM_NUMBER=

SMARTQMS_ML_URL=
PYTHON_ML_TOKEN=
SMARTQMS_ML_DB_HOST=
SMARTQMS_ML_DB_USER=
SMARTQMS_ML_DB_PASS=
SMARTQMS_ML_DB_NAME=
